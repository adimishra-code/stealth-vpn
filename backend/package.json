{
  "name": "stealth-vpn-backend",
  "version": "1.0.0",
  "description": "StealthVPN — Production-grade stealth VPN backend API",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "seed": "node ../scripts/seed-nodes.js",
    "test-provision": "node scripts/test-provision.js",
    "lint": "eslint src --max-warnings 0",
    "lint:fix": "eslint src --fix",
    "test": "jest --forceExit --detectOpenHandles",
    "test:integration": "jest --forceExit --detectOpenHandles tests/integration"
  },
  "jest": {
    "testEnvironment": "node",
    "setupFiles": [
      "<rootDir>/tests/setup-env.js"
    ],
    "testMatch": [
      "<rootDir>/tests/**/*.test.js"
    ]
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "cookie-parser": "^1.4.6",
    "cors": "^2.8.5",
    "csrf-csrf": "^4.0.3",
    "dotenv": "^17.4.2",
    "express": "^4.22.2",
    "express-mongo-sanitize": "^2.2.0",
    "express-rate-limit": "^8.6.2",
    "helmet": "^8.3.0",
    "ioredis": "^6.0.0",
    "ipaddr.js": "^2.2.0",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^9.9.3",
    "morgan": "^1.10.0",
    "node-cron": "^4.6.0",
    "node-ssh": "^13.2.0",
    "nodemailer": "^9.0.5",
    "otplib": "^11.0.1",
    "qrcode": "^1.5.4",
    "razorpay": "^2.9.4",
    "redlock": "^5.0.0-beta.2",
    "stripe": "^22.5.0",
    "winston": "^3.14.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@testing-library/user-event": "^14.6.5",
    "eslint": "^9.39.5",
    "jest": "^30.4.2",
    "mongodb-memory-server": "^11.2.0",
    "nodemon": "^3.1.4",
    "supertest": "^7.0.0"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
