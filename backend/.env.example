# ──────────────────────────────────────────────────────────────────────────────
# StealthVPN Backend Environment Variables
# ──────────────────────────────────────────────────────────────────────────────
# Copy to .env and fill in all values.
# The app will crash at startup if any required value is missing.

# ── App ───────────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=5000
FRONTEND_URL=http://localhost:5173

# Set to false on every API worker EXCEPT exactly one — that worker runs the
# cron jobs (expiry, bandwidth, health). Two workers with true = duplicate
# emails, doubled bandwidth deltas, doubled SSH load.
CRON_ENABLED=true

# Number of reverse-proxy hops to trust for req.ip (Cloudflare/nginx: 1).
# Rate limiting keys on req.ip — 0 behind a proxy means one user can
# rate-limit everyone.
TRUST_PROXY=0

# When true, devices over their plan quota get revoked by the bandwidth cron.
# Basic = 500 GB/month. Pro/team = unlimited.
QUOTA_ENFORCE=true

# ── MongoDB ───────────────────────────────────────────────────────────────────
# MongoDB MUST run with authentication (setup.sh enables it and creates these
# users). Alphanumeric passwords only — special chars would need URI escaping.
MONGO_URI=mongodb://stealthApp:app-password-here@127.0.0.1:27017/stealthvpn?authSource=stealthvpn
MONGO_ADMIN_PASSWORD=admin-password-here
MONGO_APP_PASSWORD=app-password-here

# ── JWT ───────────────────────────────────────────────────────────────────────
# HMAC fallback — kept during migration, removed once ES256 is live.
JWT_ACCESS_SECRET=your-64-char-random-hex-string-here-change-in-production
JWT_REFRESH_SECRET=another-64-char-random-hex-string-change-in-production
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=30d

# JWT-01: ES256 (ECDSA P-256) signing — base64 DER (SPKI public, PKCS8 private).
# Generate with: node scripts/generate-jwt-keys.js (see that file for the
# migration order). Both or neither per token type.
# JWT_ACCESS_PUBLIC_KEY=
# JWT_ACCESS_PRIVATE_KEY=
# JWT_REFRESH_PUBLIC_KEY=
# JWT_REFRESH_PRIVATE_KEY=

# ── WireGuard Key Encryption ──────────────────────────────────────────────────
WG_ENCRYPTION_KEY=your-64-char-hex-encryption-key-change-in-production

# ── Razorpay (INR payments) ───────────────────────────────────────────────────
RAZORPAY_KEY_ID=rzp_test_...
RAZORPAY_KEY_SECRET=...
RAZORPAY_WEBHOOK_SECRET=...

# ── Stripe (international payments) ───────────────────────────────────────────
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# ── SSH (path to private key for VPN node access) ─────────────────────────────
SSH_PRIVATE_KEY_PATH=/home/stealth/.ssh/vpn_nodes_ed25519

# Non-root SSH user on the VPN nodes (created by scripts/provision-node.sh).
# The API runs privileged node commands (wg/wg-quick/tc/xray api) through the
# sudoers whitelist installed by that script — never log in as root.
NODE_SSH_USER=stealthnode

# ── Email (Brevo / Resend / SMTP) ─────────────────────────────────────────────
SMTP_HOST=smtp.brevo.com
SMTP_PORT=587
SMTP_USER=...
SMTP_PASS=...
EMAIL_FROM=noreply@stealthvpn.com

# ── Alerting (optional — every key below can be left empty) ───────────────────
# 5xx errors, cron failures, node-down events and process crashes dispatch to
# every channel configured here. All optional — unset them to run without
# alerting (local logs only).
#
# Email alerts (uses SMTP_* above):
ALERT_EMAIL_TO=ops@example.com
#
# Generic webhook (Slack/Discord/Telegram-style JSON POST; both "text" and
# "content" keys are sent so Slack and Discord both render it):
# ALERT_WEBHOOK_URL=https://hooks.slack.com/services/...
#
# Min minutes between alerts with the same signature (dedupes alert storms):
ALERT_COOLDOWN_MINUTES=5
#
# Sentry: install `npm i @sentry/node` in backend/ then set the DSN. The code
# lazy-loads it and runs fine without it.
# SENTRY_DSN=https://xxxxx@sentry.io/12345

# ── Server Nodes ──────────────────────────────────────────────────────────────
# Mumbai (Contabo)
NODE_MUMBAI_IP=
NODE_MUMBAI_WG_PUBLIC_KEY=
NODE_MUMBAI_REALITY_PUBLIC_KEY=
NODE_MUMBAI_REALITY_SHORT_ID=

# Frankfurt (Hetzner)
NODE_FRANKFURT_IP=
NODE_FRANKFURT_WG_PUBLIC_KEY=
NODE_FRANKFURT_REALITY_PUBLIC_KEY=
NODE_FRANKFURT_REALITY_SHORT_ID=

# ── Deployment / node bootstrap (consumed by deploy/setup.sh) ─────────────────
# Used to build /etc/wireguard/wg0.conf and /usr/local/etc/xray/config.json on
# a fresh VPS. The API itself reads the per-node NODE_* values above; these
# are the generic bootstrap defaults for the deploy script.
WG_INTERFACE=wg0
WG_SERVER_PUBLIC_IP=
WG_SERVER_PUBLIC_KEY=
WG_IP_POOL=10.8.0.0/24

# ── Xray / stealth mode ───────────────────────────────────────────────────────
# gRPC API endpoint on each node (xray api CLI). XRAY_PUBLIC_KEY and
# XRAY_SHORT_ID are per-node — they come from NODE_*_REALITY_* above and are
# only listed here as deploy-time defaults. XRAY_SNI_DEST is the TLS 1.3 site
# Reality impersonates in the handshake (must match provision-node.sh).
XRAY_API_URL=http://127.0.0.1:10085
XRAY_PUBLIC_KEY=
XRAY_SHORT_ID=
XRAY_SNI_DEST=microsoft.com