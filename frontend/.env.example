# Razorpay key ID (test key for local dev - the same key id works in test mode)
VITE_RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxx

# Optional: absolute backend origin for split-origin deployments.
# The app talks to the same-origin /api (proxied by nginx in production and by
# Vite's dev proxy locally), so this is NOT read by the code — leave it unset
# unless you serve the API from a different domain and wire it into
# src/app/api.js yourself.
# VITE_API_URL=https://api.example.com
